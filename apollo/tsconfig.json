{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "baseUrl": "./src",
    "rootDirs": ["src"],
    "module": "ESNext",
    "moduleResolution": "node",
    "paths": {
      "@/*": ["*"]
    },
    "types": ["node"],
    "strict": true,
    "outDir": "dist",
    "esModuleInterop": true,
    "skipLibCheck": true
  }
}
