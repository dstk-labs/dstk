{
  "type": "module",
  "private": true,
  "scripts": {
    "compile": "tsc",
    "schemagen": "kysely-codegen --dialect postgres --out-file ./src/db/db.d.ts",
    "start": "pnpm run schemagen && pnpm run compile && node ./dist/index.js",
    "dev": "NODE_ENV=dev && pnpm run start",
    "lint": "eslint 'src/**/*.ts' --config ./eslint.config.mjs",
    "lint:fix": "eslint 'src/**/*.ts' --fix --config ./eslint.config.mjs",
    "format": "prettier 'src/**/*.ts' --write --config ./.prettierrc.json",
    "format:fix": "prettier 'src/**/*.ts' --write --config ./.prettierrc.json",
    "prepare": "cd .. && husky ./apollo/.husky"
  },
  "dependencies": {
    "@apollo/server": "^4.11.3",
    "@aws-sdk/client-s3": "^3.777.0",
    "@aws-sdk/s3-request-presigner": "^3.777.0",
    "@aws-sdk/types": "^3.775.0",
    "@aws-sdk/util-format-url": "^3.775.0",
    "@pothos/core": "^4.5.1",
    "@pothos/plugin-scope-auth": "^4.1.2",
    "@smithy/hash-node": "^4.0.2",
    "@smithy/protocol-http": "^5.1.0",
    "@smithy/url-parser": "^4.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "argon2": "^0.41.1",
    "aws-sdk": "^2.1692.0",
    "better-auth": "^1.2.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "graphql": "^16.10.0",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.27.6",
    "nexus": "^1.3.0",
    "pg": "^8.14.1",
    "ts-node": "^10.9.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.23.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.14",
    "@types/pg": "^8.11.11",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "husky": "^9.1.7",
    "kysely-codegen": "^0.18.3",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "source-map-loader": "^5.0.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.2",
    "webpack": "^5.98.0"
  }
}