# Ignore everything
*

# But descend into directories
!*/

# but still exclude generated folders
*.egg-info/
*.ipynb_checkpoints/
*node_modules
*.pnp
*coverage
*build
*dist

# And permit certain files
!.dockerignore
!.env.example
!.gitignore
!LICENSE

# And filetypes
!*.yml
!*.yaml
!*.json
!*.tsx
!*.ts
!*.jsx
!*.js
!*.cjs
!*.css
!*.svg
!*.html
!*.md
!*.sh
!*.sql
!*.graphql
!.prettierrc
!.prettierignore
!Dockerfile
!*.config.mjs
!pre-commit
!*.png

# And certain folders, regardless of content
!*assets/*
!*public/*

# But don't allow autogenerated things
web/src/graphql/*
