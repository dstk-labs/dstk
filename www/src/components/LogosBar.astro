---
const frameworks = ["scikit-learn", "PyTorch", "TensorFlow", "XGBoost", "HuggingFace", "ONNX"];
---

<div class="logos">
  <p class="label">Plays nice with</p>
  <ul class="row">
    {frameworks.map(framework => <li>{framework}</li>)}
  </ul>
</div>

<style>
  .logos {
    padding: 64px 32px 40px;
    text-align: center;
  }

  .label {
    color: var(--color-text-muted);
    font-size: var(--font-size-2xs);
    font-weight: var(--font-regular);
    letter-spacing: 2px;
    margin-bottom: 28px;
    text-transform: uppercase;
  }

  .row {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    justify-content: center;
    list-style: none;
    opacity: 0.35;
  }

  li {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    font-weight: var(--font-medium);
    letter-spacing: 1px;
  }

  @media (max-width: 768px) {
    .row {
      gap: 24px 32px;
    }
  }
</style>
