{
  "name": "web",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prepare": "cd .. && husky ./web/.husky",
    "codegen": "graphql-codegen --config ./src/config/codegen.ts",
    "dev": "pnpm codegen && vite",
