    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@mantine/core": "^8.0.2",
    "@mantine/dropzone": "^8.2.4",
    "@mantine/form": "^8.0.2",
    "@mantine/hooks": "^8.0.2",
    "@mantine/notifications": "^8.0.2",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "graphql": "^16.11.0",
    "lucide-react": "^0.513.0",
    "mantine-form-zod-resolver": "^1.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.2",
    "zod": "^3.25.53",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.1.0",
    "@eslint-react/eslint-plugin": "^2.7.2",
